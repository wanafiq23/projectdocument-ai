# Keep credentials in backend/.env only. Never commit them.
# Existing local PostgreSQL setup:
POSTGRES_PASSWORD=
# Or leave the password above blank and supply a localhost URL:
# DATABASE_URL=postgresql+psycopg://projectdocumentai:YOUR_PASSWORD@localhost:5432/projectdocumentai
SESSION_DAYS=7
# UPLOAD_DIR=C:/your/local/uploads

# Gemini and MongoDB Atlas (required for AI; management features work without these)
# Enter your REAL Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
MONGODB_URI=
MONGODB_DATABASE=projectdocumentai
MONGODB_VECTOR_INDEX=projectdocumentai_vectors

ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:4173","http://127.0.0.1:4173","http://localhost:8000","http://127.0.0.1:8000"]
